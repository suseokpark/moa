{
  "manifest_version": 3,
  "name": "Moa",
  "version": "0.1.9",
  "description": "Organize rendered Notion Favorites into collapsible groups and sections.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/moa-16.png",
    "32": "icons/moa-32.png",
    "48": "icons/moa-48.png",
    "128": "icons/moa-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Moa",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/moa-16.png",
      "32": "icons/moa-32.png",
      "48": "icons/moa-48.png",
      "128": "icons/moa-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.notion.com/*"
      ],
      "js": [
        "src/favorite-tree-model.js",
        "src/profile-catalog.js",
        "src/notion-sidebar-adapter.js",
        "src/favorite-tree-view.js",
        "src/moa-brand.js",
        "src/notion-tree-panel.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
