{
  "manifest_version": 3,
  "name": "FAVMOA",
  "version": "0.1.22",
  "key": "",
  "description": "팹모아 — Organize links into groups and subgroups, find the current page, and switch to existing tabs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "optional_permissions": ["bookmarks"],
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "icons": {
    "16": "icons/moa-16.png",
    "32": "icons/moa-32.png",
    "48": "icons/moa-48.png",
    "128": "icons/moa-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FAVMOA",
    "default_icon": {
      "16": "icons/moa-16.png",
      "32": "icons/moa-32.png",
      "48": "icons/moa-48.png",
      "128": "icons/moa-128.png"
    }
  }
}
